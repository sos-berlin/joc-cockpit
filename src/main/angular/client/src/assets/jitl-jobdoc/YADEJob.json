{
  "job": {
    "name": "YADEJob",
    "category": "JITL",
    "language": "Java",
    "class": "com.sos.jitl.jobs.yade.YADEJob"
  },
  "arguments": [
    {
      "name": "settings",
      "required": true,
      "dataType": "STRING"
    },
    {
      "name": "profile",
      "required": true,
      "dataType": "STRING"
    },
    {
      "name": "source_dir",
      "required": false,
      "dataType": "STRING"
    },
    {
      "name": "source_excluded_directories",
      "required": false,
      "dataType": "STRING"
    },
    {
      "name": "source_file_path",
      "required": false,
      "dataType": "STRING"
    },
    {
      "name": "source_file_spec",
      "required": false,
      "dataType": "STRING"
    },
    {
      "name": "source_file_list",
      "required": false,
      "dataType": "STRING"
    },
    {
      "name": "source_recursive",
      "required": false,
      "dataType": "BOOLEAN"
    },
    {
