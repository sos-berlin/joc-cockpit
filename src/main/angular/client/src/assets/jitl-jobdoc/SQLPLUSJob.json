    {
      "name": "db_user",
      "required": false,
      "dataType": "STRING"
    },
    {
      "name": "db_password",
      "required": false,
      "dataType": "STRING"
    },
    {
      "$ref": "include/sql/param_sqlplus_script_file.json"
    },
    {
      "name": "include_files",
      "required": false,
      "dataType": "STRING"
    },
    {
