{
  "job": {
    "name": "MonitoringJob",
    "category": "JITL",
    "language": "Java",
    "class": "com.sos.jitl.jobs.monitoring.MonitoringJob"
  },
  "arguments": [
    {
      "name": "controller_id",
      "required": false,
      "dataType": "STRING"
    },
    {
      "name": "monitor_report_dir",
      "required": true,
      "dataType": "STRING"
    },
    {
      "name": "monitor_report_max_files",
      "required": false,
      "dataType": "POSITIVEINTEGER",
      "defaultValue": 30
    },
    {
      "name": "max_failed_orders",
      "required": false,
      "dataType": "INTEGER",
      "defaultValue": -1
    },
    {
      "name": "from",
      "required": false,
      "dataType": "STRING"
    }
  ],
  "returnVariables": [
    {
      "name": "monitor_report_date",
      "required": false,
      "dataType": "STRING"
    },
    {
      "name": "monitor_report_file",
      "required": false,
      "dataType": "STRING"
    },
    {
      "name": "subject",
      "required": false,
      "dataType": "STRING"
    },
    {
      "name": "body",
      "required": false,
      "dataType": "STRING"
    },
    {
      "name": "result",
      "required": false,
      "dataType": "NONNEGATIVEINTEGER"
    }
  ]
}